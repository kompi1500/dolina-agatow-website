---
// Hero „z kosmosu do doliny”: kontener na scenę Three.js (glob → mapa).
// Warstwy: #globe-canvas (Three.js), #hero-map (MapLibre), .hero-overlay (tytuł).
// Skrypt hero-globe.ts montuje się tylko gdy WebGL dostępny i brak prefers-reduced-motion;
// w przeciwnym razie zostaje statyczne tło gwiazd + od razu widoczny tytuł.
---

<section class="hero" id="top">
  <div class="hero-stage" id="hero-stage" data-hero>
    <canvas id="globe-canvas" aria-hidden="true"></canvas>
    <div id="hero-map" aria-hidden="true"></div>
  </div>

  <div class="hero-overlay" id="hero-overlay">
    <p class="hero-kicker">Płóczki Górne · Nagórze · Pogórze Izerskie</p>
    <h1>Dolina Agatów</h1>
    <p class="hero-sub">
      Stowarzyszenie na Rzecz Rozwoju Płóczek Górnych, Nagórza i&nbsp;Okolic
    </p>
    <a href="#o-nas" class="hero-scroll" aria-label="Przewiń do treści">
      <span></span>
    </a>
  </div>

  <button type="button" class="hero-skip" id="hero-skip">Pomiń intro</button>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 120%, #16233d 0%, transparent 55%),
      var(--kosmos);
    color: var(--krem);
  }

  .hero-stage,
  .hero-stage canvas,
  #hero-map {
    position: absolute;
    inset: 0;
  }

  #hero-map {
    opacity: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-inline: var(--pad-x);
    pointer-events: none;
    text-shadow: 0 2px 24px rgb(5 7 15 / 0.65);
  }

  .hero-overlay > * {
    pointer-events: auto;
  }

  .hero-kicker {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bursztyn-jasny);
    margin: 0 0 1rem;
  }

  .hero-overlay h1 {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 9vw, 5.5rem);
    font-weight: 480;
    color: var(--krem);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .hero-sub {
    font-size: clamp(0.95rem, 2.2vw, 1.2rem);
    color: rgb(250 246 239 / 0.82);
    max-width: 34rem;
    margin: 1.1rem 0 0;
  }

  .hero-scroll {
    margin-top: 3rem;
    width: 1.6rem;
    height: 2.6rem;
    border: 2px solid rgb(250 246 239 / 0.5);
    border-radius: 1rem;
    display: grid;
    justify-content: center;
    padding-top: 0.5rem;
  }

  .hero-scroll span {
    width: 3px;
    height: 0.6rem;
    border-radius: 2px;
    background: var(--bursztyn-jasny);
    animation: scroll-hint 1.8s ease-in-out infinite;
  }

  @keyframes scroll-hint {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }

    60% {
      transform: translateY(0.7rem);
      opacity: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll span {
      animation: none;
    }
  }

  .hero-skip {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 20;
    background: rgb(5 7 15 / 0.45);
    color: rgb(250 246 239 / 0.8);
    border: 1px solid rgb(250 246 239 / 0.25);
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    display: none;
    backdrop-filter: blur(6px);
  }

  .hero-skip:hover {
    border-color: var(--bursztyn-jasny);
    color: var(--bursztyn-jasny);
  }

  .hero-skip.visible {
    display: block;
  }
</style>
