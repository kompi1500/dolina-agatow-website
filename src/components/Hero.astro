---
// Hero: mapa MapLibre (ortofoto Sentinel-2) z krótkim zjazdem znad Polski na Płóczki Górne.
// Warstwy: #globe-canvas (gwiazdy 2D na czas preloadu), #hero-map, .hero-overlay (tytuł).
// hero-globe.ts preładowuje kafelki trasy po ciemku i odpala animację tylko przy WebGL
// i braku prefers-reduced-motion; w przeciwnym razie od razu finalny widok + tytuł.
---

<section class="hero" id="top">
  <div class="hero-stage" id="hero-stage" data-hero>
    <canvas id="globe-canvas" aria-hidden="true"></canvas>
    <div id="hero-map" aria-hidden="true" role="region" aria-label="Interaktywna mapa Doliny Agatów"></div>
  </div>

  <div class="hero-overlay" id="hero-overlay">
    <p class="hero-sub">
      Stowarzyszenie na Rzecz Rozwoju Płóczek Górnych, Nagórza i&nbsp;Okolic
    </p>
    <h1>Dolina Agatów</h1>
    <p class="hero-detal">Płóczki Górne · Nagórze · Pogórze Izerskie</p>
  </div>

  <script is:inline>
    // tytuł znika PRZED pierwszym paintem (żadnego błysku przy odświeżeniu);
    // bez JS skrypt się nie wykona i tytuł normalnie widać
    document.getElementById('hero-overlay').classList.add('hidden');
  </script>

  <button type="button" class="hero-skip" id="hero-skip">Pomiń intro</button>

  <output class="hero-coordinates" id="hero-coordinates" aria-label="Współrzędne wskazanego miejsca"></output>

  <nav class="hero-map-controls" id="hero-map-controls" aria-label="Sterowanie mapą">
    <button type="button" class="map-control map-control--wide" data-map-action="reset" aria-label="Wróć do Doliny Agatów">
      <span aria-hidden="true">⌖</span><span>Dolina</span>
    </button>
    <button type="button" class="map-control map-control--wide" data-map-action="layer" data-mode="satellite" aria-pressed="true" aria-label="Zmień podkład mapy">
      <span aria-hidden="true">◫</span><span data-layer-label>Satelita</span>
    </button>
    <div class="map-control-pair">
      <button type="button" class="map-control" data-map-action="zoom-in" aria-label="Przybliż mapę">+</button>
      <button type="button" class="map-control" data-map-action="zoom-out" aria-label="Oddal mapę">−</button>
    </div>
    <button type="button" class="map-control map-compass" data-map-action="compass" aria-label="Ustaw północ u góry"><span aria-hidden="true">↑</span></button>
    <button type="button" class="map-control" data-map-action="fullscreen" aria-label="Włącz pełny ekran" aria-pressed="false"><span aria-hidden="true">⛶</span></button>
  </nav>
</section>

<script>
  import '../scripts/hero-globe';
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 120%, #2b2113 0%, transparent 55%),
      var(--kosmos);
    color: var(--krem);
  }

  .hero-stage,
  .hero-stage canvas,
  #hero-map {
    position: absolute;
    inset: 0;
  }

  .hero-stage canvas {
    width: 100%;
    height: 100%;
  }

  #hero-map {
    inset: -6px;
    opacity: 0;
    transition: opacity 0.4s linear;
  }

  /* przyciemnienie od pierwszej klatki (bez przełączki po wylądowaniu):
     napisy mapy i tytuł zawsze na pierwszym planie */
  .hero-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 22vmin rgb(8 7 6 / 0.6);
    background:
      linear-gradient(180deg, rgb(8 7 6 / 0.6) 0%, transparent 18%),
      linear-gradient(0deg, rgb(8 7 6 / 0.55) 0%, transparent 42%),
      rgb(8 7 6 / 0.22);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-inline: var(--pad-x);
    pointer-events: none;
    text-shadow: 0 2px 24px rgb(8 7 6 / 0.65);
  }

  .hero-overlay > * {
    pointer-events: auto;
  }

  .hero-overlay.hidden {
    opacity: 0;
    visibility: hidden;
  }

  .hero-overlay {
    transition:
      opacity 1.4s ease,
      visibility 1.4s;
  }

  /* po wylądowaniu blok tytułowy podchodzi pod pineskę (wieś w górnym złotym cięciu) */
  .hero-stage.done + .hero-overlay {
    justify-content: flex-end;
    padding-bottom: calc(clamp(13rem, 45vh, 27rem) - 10px);
  }

  /* typografia w proporcjach φ: tytuł 4.6rem → nazwa 4.6/φ² ≈ 1.75rem → detal 1.75/φ ≈ 1.08...
     detal celowo o krok mniejszy (φ³): 4.6/4.236 ≈ 1.08 → optycznie 0.82rem po spersowaniu */
  .hero-overlay h1 {
    font-family: var(--font-display);
    font-size: clamp(2.9rem, 8.5vw, 4.6rem);
    font-weight: 480;
    color: var(--krem);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .hero-sub {
    font-size: clamp(1rem, 2.4vw, 1.375rem);
    font-weight: 550;
    color: rgb(250 246 239 / 0.92);
    max-width: 40rem;
    margin: 0 0 0.62rem;
  }

  .hero-detal {
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bursztyn-jasny);
    margin: 1em 0 0;
  }

  .hero-skip {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 20;
    background: rgb(8 7 6 / 0.45);
    color: rgb(250 246 239 / 0.8);
    border: 1px solid rgb(250 246 239 / 0.25);
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    display: none;
    backdrop-filter: blur(6px);
  }

  .hero-skip:hover {
    border-color: var(--bursztyn-jasny);
    color: var(--bursztyn-jasny);
  }

  .hero-skip.visible {
    display: block;
  }

  .hero-coordinates {
    position: absolute;
    z-index: 20;
    left: 1.25rem;
    bottom: 1.25rem;
    display: block;
    padding: 0 0 0 1.15rem;
    border: 0;
    background: transparent;
    color: rgb(250 246 239 / 0.72);
    font: 520 0.73rem/1 var(--font-body);
    letter-spacing: 0.065em;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transform: translateY(0.4rem);
    transition: opacity 0.35s ease, transform 0.35s ease;
    pointer-events: none;
  }

  .hero-coordinates::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.72rem;
    height: 1px;
    background: var(--bursztyn-jasny);
    box-shadow: 0 0 8px rgb(232 161 60 / 0.4);
  }

  .hero-coordinates.visible {
    opacity: 1;
    transform: none;
  }

  .hero-map-controls {
    position: absolute;
    z-index: 20;
    right: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.42rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
    transition: opacity 0.35s ease, transform 0.35s ease, visibility 0.35s;
  }

  .hero-map-controls.visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .map-control,
  .map-control-pair {
    border: 1px solid rgb(250 246 239 / 0.22);
    background: rgb(8 7 6 / 0.58);
    color: rgb(250 246 239 / 0.9);
    backdrop-filter: blur(9px);
  }

  .map-control {
    min-width: 2.55rem;
    height: 2.55rem;
    padding: 0 0.7rem;
    border-radius: 0.25rem;
    font: 600 0.76rem/1 var(--font-body);
    cursor: pointer;
  }

  .map-control:hover,
  .map-control:focus-visible {
    color: var(--bursztyn-jasny);
    border-color: rgb(232 161 60 / 0.72);
  }

  .map-control--wide {
    display: flex;
    align-items: center;
    gap: 0.52rem;
    min-width: 6.7rem;
    justify-content: flex-start;
  }

  .map-control-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 0.25rem;
    overflow: hidden;
  }

  .map-control-pair .map-control {
    border: 0;
    border-radius: 0;
    background: transparent;
    font-size: 1.2rem;
  }

  .map-control-pair .map-control + .map-control { border-left: 1px solid rgb(250 246 239 / 0.18); }

  .map-compass {
    display: none;
  }

  .map-compass.visible { display: block; }
  .map-compass span { display: inline-block; transform: rotate(var(--bearing, 0deg)); }

  .hero:fullscreen { height: 100vh; }

  @media (max-width: 680px) {
    .hero { min-height: 30rem; }
    .hero-stage.done + .hero-overlay { padding-bottom: calc(clamp(12.5rem, 42vh, 18rem) - 8px); }
    .hero-sub { max-width: 22rem; font-size: clamp(0.92rem, 4vw, 1.1rem); }
    .hero-detal { max-width: 20rem; line-height: 1.65; }
    .hero-map-controls { right: 0.75rem; bottom: 0.75rem; }
    .hero-coordinates { left: 0.75rem; bottom: 0.75rem; font-size: 0.64rem; }
    .map-control { min-width: 2.75rem; height: 2.75rem; }
    .map-control--wide { min-width: 2.75rem; width: 2.75rem; padding: 0; justify-content: center; }
    .map-control--wide span:last-child { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .map-control-pair { grid-template-columns: 2.75rem; }
    .map-control-pair .map-control + .map-control { border-left: 0; border-top: 1px solid rgb(250 246 239 / 0.18); }
    .hero-skip { right: 0.75rem; bottom: 0.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    #hero-map,
    .hero-overlay,
    .hero-map-controls,
    .hero-coordinates { transition-duration: 0.01ms; }
  }
</style>
