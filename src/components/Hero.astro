---
// Hero „z kosmosu do doliny”: kontener na scenę Three.js (glob → mapa).
// Warstwy: #globe-canvas (Three.js), #hero-map (MapLibre), .hero-overlay (tytuł).
// Skrypt hero-globe.ts montuje się tylko gdy WebGL dostępny i brak prefers-reduced-motion;
// w przeciwnym razie zostaje statyczne tło gwiazd + od razu widoczny tytuł.
---

<section class="hero" id="top">
  <div class="hero-stage" id="hero-stage" data-hero>
    <canvas id="globe-canvas" aria-hidden="true"></canvas>
    <div id="hero-map" aria-hidden="true"></div>
  </div>

  <div class="hero-overlay" id="hero-overlay">
    <p class="hero-sub">
      Stowarzyszenie na Rzecz Rozwoju Płóczek Górnych, Nagórza i&nbsp;Okolic
    </p>
    <h1>Dolina Agatów</h1>
    <p class="hero-detal">Płóczki Górne · Nagórze · Pogórze Izerskie</p>
  </div>

  <button type="button" class="hero-skip" id="hero-skip">Pomiń intro</button>
</section>

<script>
  import '../scripts/hero-globe';
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 120%, #2b2113 0%, transparent 55%),
      var(--kosmos);
    color: var(--krem);
  }

  .hero-stage,
  .hero-stage canvas,
  #hero-map {
    position: absolute;
    inset: 0;
  }

  .hero-stage canvas {
    width: 100%;
    height: 100%;
  }

  #hero-map {
    opacity: 0;
    transition: opacity 0.4s linear;
  }

  /* przyciemnienie od pierwszej klatki (bez przełączki po wylądowaniu):
     napisy mapy i tytuł zawsze na pierwszym planie */
  .hero-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 22vmin rgb(8 7 6 / 0.6);
    background:
      linear-gradient(180deg, rgb(8 7 6 / 0.6) 0%, transparent 18%),
      linear-gradient(0deg, rgb(8 7 6 / 0.55) 0%, transparent 42%),
      rgb(8 7 6 / 0.22);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-inline: var(--pad-x);
    pointer-events: none;
    text-shadow: 0 2px 24px rgb(8 7 6 / 0.65);
  }

  .hero-overlay > * {
    pointer-events: auto;
  }

  .hero-overlay.hidden {
    opacity: 0;
    visibility: hidden;
  }

  .hero-overlay {
    transition:
      opacity 1.4s ease,
      visibility 1.4s;
  }

  /* po wylądowaniu blok tytułowy podchodzi pod pineskę (wieś w górnym złotym cięciu) */
  .hero-stage.done + .hero-overlay {
    justify-content: flex-end;
    padding-bottom: clamp(8rem, 28vh, 17rem);
  }

  /* typografia w proporcjach φ: tytuł 4.6rem → nazwa 4.6/φ² ≈ 1.75rem → detal 1.75/φ ≈ 1.08...
     detal celowo o krok mniejszy (φ³): 4.6/4.236 ≈ 1.08 → optycznie 0.82rem po spersowaniu */
  .hero-overlay h1 {
    font-family: var(--font-display);
    font-size: clamp(2.9rem, 8.5vw, 4.6rem);
    font-weight: 480;
    color: var(--krem);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .hero-sub {
    font-size: clamp(1rem, 2.4vw, 1.375rem);
    font-weight: 550;
    color: rgb(250 246 239 / 0.92);
    max-width: 40rem;
    margin: 0 0 0.62rem;
  }

  .hero-detal {
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bursztyn-jasny);
    margin: 1em 0 0;
  }

  .hero-skip {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 20;
    background: rgb(8 7 6 / 0.45);
    color: rgb(250 246 239 / 0.8);
    border: 1px solid rgb(250 246 239 / 0.25);
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    display: none;
    backdrop-filter: blur(6px);
  }

  .hero-skip:hover {
    border-color: var(--bursztyn-jasny);
    color: var(--bursztyn-jasny);
  }

  .hero-skip.visible {
    display: block;
  }
</style>
