---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: '#o-nas', label: 'O nas' },
  { href: '#dolina', label: 'Dolina Agatów' },
  { href: '#kontakt', label: 'Kontakt' },
  { href: `${base}/regulamin/`, label: 'Regulamin' },
];
---

<nav class="nav" id="site-nav" aria-label="Nawigacja główna">
  <div class="container nav-inner">
    <a href="#top" class="brand">Dolina Agatów</a>
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-block: 0.9rem;
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease,
      padding 0.3s ease;
  }

  .nav.scrolled {
    background: color-mix(in srgb, var(--kosmos) 42%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.08);
    padding-block: 0.55rem;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 620;
    font-size: 1.15rem;
    color: var(--krem);
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .brand:hover {
    color: var(--bursztyn-jasny);
  }

  ul {
    display: flex;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    color: rgb(250 246 239 / 0.85);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 550;
  }

  ul a:hover {
    color: var(--bursztyn-jasny);
  }

  @media (max-width: 640px) {
    .brand {
      font-size: 1rem;
    }

    ul {
      gap: 0.7rem;
    }

    ul a {
      font-size: 0.8rem;
    }
  }
</style>
