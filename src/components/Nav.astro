---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: '#mikroatlas', label: 'Mikroatlas' },
  { href: '#o-nas', label: 'O stowarzyszeniu' },
  { href: '#dolacz', label: 'Dołącz' },
  { href: `${base}/regulamin/`, label: 'Regulamin' },
];
---

<nav class="nav" id="site-nav" aria-label="Nawigacja główna">
  <div class="nav-inner">
    <a href="#top" class="brand" aria-label="Dolina Agatów — strona główna">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>Dolina Agatów</span>
    </a>

    <ul class="desktop-links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>

    <button class="menu-open" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      Menu
    </button>
  </div>
</nav>

<dialog class="mobile-menu" id="mobile-menu" data-mobile-menu aria-label="Menu główne">
  <div class="mobile-menu-inner">
    <header>
      <span>Dolina Agatów</span>
      <button type="button" data-menu-close aria-label="Zamknij menu">×</button>
    </header>
    <ol>
      {links.map((link, index) => (
        <li>
          <span aria-hidden="true">0{index + 1}</span>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ol>
    <p>Płóczki Górne · Nagórze · Pogórze Izerskie</p>
  </div>
</dialog>

<script>
  const nav = document.getElementById('site-nav');
  const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
  const open = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const close = dialog?.querySelector<HTMLButtonElement>('[data-menu-close]');

  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 32);
  const closeMenu = () => dialog?.close();

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  open?.addEventListener('click', () => {
    dialog?.showModal();
    open.setAttribute('aria-expanded', 'true');
    document.body.classList.add('dialog-open');
  });
  close?.addEventListener('click', closeMenu);
  dialog?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeMenu();
  });
  dialog?.addEventListener('close', () => {
    open?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('dialog-open');
    open?.focus();
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--krem);
    transition: background 0.25s ease, border-color 0.25s ease;
    border-bottom: 1px solid transparent;
  }

  .nav.scrolled {
    background: rgb(8 7 6 / 0.9);
    border-bottom-color: rgb(250 246 239 / 0.12);
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    width: min(100% - 2 * var(--pad-x), 92rem);
    min-height: 4.5rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 620;
  }

  .brand-mark {
    width: 1rem;
    height: 1rem;
    border: 1px solid var(--bursztyn-jasny);
    border-radius: 50%;
    box-shadow: inset 0 0 0 3px rgb(8 7 6 / 0.65);
    background: var(--bursztyn);
  }

  .desktop-links {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .desktop-links a {
    color: rgb(250 246 239 / 0.86);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 570;
  }

  .desktop-links a:hover,
  .desktop-links a:focus-visible {
    color: var(--bursztyn-jasny);
  }

  .menu-open {
    display: none;
    padding: 0.55rem 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font: 650 0.82rem/1 var(--font-body);
    cursor: pointer;
  }

  .mobile-menu {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--kosmos);
    color: var(--krem);
  }

  .mobile-menu::backdrop {
    background: var(--kosmos);
  }

  .mobile-menu-inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding: 1.2rem var(--pad-x) 1.8rem;
    background:
      radial-gradient(circle at 85% 12%, rgb(217 131 36 / 0.18), transparent 24rem),
      var(--kosmos);
  }

  .mobile-menu header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-display);
  }

  .mobile-menu header button {
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(250 246 239 / 0.22);
    background: transparent;
    color: var(--krem);
    font-size: 1.8rem;
  }

  .mobile-menu ol {
    list-style: none;
    margin: auto 0;
    padding: 2rem 0;
  }

  .mobile-menu li {
    display: grid;
    grid-template-columns: 2.3rem 1fr;
    align-items: baseline;
    padding-block: 0.85rem;
    border-bottom: 1px solid rgb(250 246 239 / 0.14);
  }

  .mobile-menu li span {
    font-size: 0.66rem;
    color: var(--bursztyn-jasny);
  }

  .mobile-menu li a {
    color: var(--krem);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(2rem, 10vw, 3rem);
    line-height: 1.1;
  }

  .mobile-menu-inner > p {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(250 246 239 / 0.55);
  }

  @media (max-width: 720px) {
    .desktop-links {
      display: none;
    }

    .menu-open {
      display: block;
    }

    .nav-inner {
      min-height: 4rem;
    }
  }
</style>
