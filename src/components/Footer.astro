---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rok = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-name">
          Stowarzyszenie na Rzecz Rozwoju Płóczek Górnych, Nagórza i Okolic — „Dolina Agatów”
        </p>
        <p class="footer-meta">
          Stowarzyszenie zwykłe wpisane do ewidencji stowarzyszeń zwykłych prowadzonej przez
          Starostę Lwóweckiego pod poz. 18 (6 lipca 2026 r.).<br />
          Płóczki Górne 4A, 59-600 Lwówek Śląski
        </p>
      </div>
      <ul class="footer-links">
        <li><a href={`${base}/regulamin/`}>Regulamin stowarzyszenia</a></li>
        <li><a href="#o-nas">O nas</a></li>
        <li><a href="#mikroatlas">Mikroatlas Doliny</a></li>
        <li><a href="#dolacz">Dołącz do nas</a></li>
      </ul>
    </div>
    <p class="footer-credits" id="atrybucje">
      © {rok} Stowarzyszenie „Dolina Agatów”. Mapa: dane
      <a href="https://www.openstreetmap.org/copyright" rel="noopener">© OpenStreetMap</a>,
      kafelki <a href="https://openfreemap.org" rel="noopener">OpenFreeMap</a>. Intro:
      <a href="https://visibleearth.nasa.gov/collection/1484/blue-marble" rel="noopener">NASA
      Blue Marble</a>, regionalny kadr Sentinel-2 cloudless 2018 — EOX
      (<a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" rel="license noopener">CC
      BY-NC-SA 4.0</a>) oraz zdjęcie Płóczek: Platanacero
      (<a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license noopener">CC
      BY-SA 4.0</a>); materiały skadrowane i skompresowane.
    </p>
    <p class="footer-credits footer-fotografie">
      Zdjęcia pochodzą z <a href="https://commons.wikimedia.org/" rel="noopener">Wikimedia
      Commons</a> — autor, licencja, źródło i zakres zmian są podane przy każdym
      materiale.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--kosmos);
    color: rgb(250 246 239 / 0.65);
    padding-block: 2.75rem;
    font-size: 0.88rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2rem;
  }

  .footer-name {
    max-width: 44rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.2;
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .footer-name {
    font-weight: 560;
    color: rgb(250 246 239 / 0.9);
    margin-top: 0;
  }

  .footer-meta {
    line-height: 1.7;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer a {
    color: rgb(250 246 239 / 0.75);
  }

  .footer a:hover {
    color: var(--bursztyn-jasny);
  }

  .footer-credits {
    margin: 2.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(250 246 239 / 0.12);
    font-size: 0.8rem;
    color: rgb(250 246 239 / 0.45);
  }

  .footer-fotografie {
    margin-top: 0;
    border-top: 0;
    padding-top: 0.6rem;
  }
</style>
