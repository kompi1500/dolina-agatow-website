---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rok = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-name">
          Stowarzyszenie na Rzecz Rozwoju Płóczek Górnych, Nagórza i Okolic — „Dolina Agatów”
        </p>
        <p class="footer-meta">
          Stowarzyszenie zwykłe wpisane do ewidencji stowarzyszeń zwykłych prowadzonej przez
          Starostę Lwóweckiego pod poz. 18 (6 lipca 2026 r.).<br />
          Płóczki Górne 4A, 59-600 Lwówek Śląski
        </p>
      </div>
      <ul class="footer-links">
        <li><a href={`${base}/regulamin/`}>Regulamin stowarzyszenia</a></li>
        <li><a href="#o-nas">O nas</a></li>
        <li><a href="#dolina">Dolina Agatów</a></li>
        <li><a href="#kontakt">Kontakt</a></li>
      </ul>
    </div>
    <p class="footer-credits" id="atrybucje">
      © {rok} Stowarzyszenie „Dolina Agatów” · Mapa:
      <a href="https://www.openstreetmap.org/copyright" rel="noopener">© OpenStreetMap</a>,
      <a href="https://openfreemap.org" rel="noopener">OpenFreeMap</a> oraz
      <a href="https://s2maps.eu" rel="noopener">Sentinel-2 cloudless 2018 — EOX</a>
      (CC BY-NC-SA 4.0) · Fotografie:
      <a href="https://commons.wikimedia.org/" rel="noopener">Wikimedia Commons</a>, autorzy
      i licencje przy zdjęciach · Obrys Polski: Natural Earth, domena publiczna.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--heban);
    color: rgb(250 246 239 / 0.65);
    padding-block: 2.25rem;
    font-size: 0.88rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .footer-name {
    font-weight: 650;
    color: rgb(250 246 239 / 0.9);
    margin-top: 0;
  }

  .footer-meta {
    line-height: 1.7;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer a {
    color: rgb(250 246 239 / 0.75);
  }

  .footer a:hover {
    color: var(--bursztyn-jasny);
  }

  .footer-credits {
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgb(250 246 239 / 0.12);
    font-size: 0.72rem;
    line-height: 1.55;
    color: rgb(250 246 239 / 0.38);
  }

  .footer-credits a {
    color: rgb(250 246 239 / 0.5);
    text-decoration-color: rgb(250 246 239 / 0.18);
  }
</style>
