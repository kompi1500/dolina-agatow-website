---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rok = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-name">
          Stowarzyszenie na Rzecz Rozwoju Płóczek Górnych, Nagórza i Okolic — „Dolina Agatów”
        </p>
        <p class="footer-meta">
          Stowarzyszenie zwykłe wpisane do ewidencji stowarzyszeń zwykłych prowadzonej przez
          Starostę Lwóweckiego pod poz. 18 (6 lipca 2026 r.).<br />
          Płóczki Górne 4A, 59-600 Lwówek Śląski
        </p>
      </div>
      <ul class="footer-links">
        <li><a href={`${base}/regulamin/`}>Regulamin stowarzyszenia</a></li>
        <li><a href="#o-nas">O nas</a></li>
        <li><a href="#dolina">Dolina Agatów</a></li>
        <li><a href="#dolacz">Dołącz do nas</a></li>
      </ul>
    </div>
    <p class="footer-credits" id="atrybucje">
      © {rok} Stowarzyszenie „Dolina Agatów”. Tekstura Ziemi w intro:
      <a href="https://www.solarsystemscope.com/textures/" rel="noopener">Solar System Scope</a>
      (CC BY 4.0, na podstawie danych NASA). Mapa: dane
      <a href="https://www.openstreetmap.org/copyright" rel="noopener">© OpenStreetMap</a>,
      kafelki <a href="https://openfreemap.org" rel="noopener">OpenFreeMap</a>.
    </p>
    <p class="footer-credits footer-fotografie">
      Zdjęcia (Wikimedia Commons): <a href="https://commons.wikimedia.org/wiki/File:Agate_from_P%C5%82%C3%B3czki_G%C3%B3rne_RN1.jpg" rel="noopener">agat — Robert Niedźwiedzki, CC BY 3.0</a> ·
      <a href="https://commons.wikimedia.org/wiki/File:Agat_-_P%C5%82%C3%B3czki_G%C3%B3rne,_G._Kaczawskie,_Poland..jpg" rel="noopener">agat — Lech Darski, CC BY-SA 3.0</a> ·
      <a href="https://commons.wikimedia.org/wiki/File:P%C5%82%C3%B3czki_G%C3%B3rne_1.jpg" rel="noopener">Płóczki Górne — Platanacero, CC BY-SA 4.0</a> ·
      <a href="https://commons.wikimedia.org/wiki/File:Pog%C3%B3rze_Izerskie_Nag%C3%B3rze1.JPG" rel="noopener">Pogórze pod Nagórzem — Platanacero, domena publiczna</a> ·
      <a href="https://commons.wikimedia.org/wiki/File:S%C5%82otwina_w_P%C5%82oczkach_G%C3%B3rnych.JPG" rel="noopener">Słotwina — Jarosław Łukaszewski, CC BY-SA 3.0</a> ·
      <a href="https://commons.wikimedia.org/wiki/File:Lw%C3%B3wek_%C5%9Al%C4%85ski_Mury_obronne.JPG" rel="noopener">mury Lwówka — Ludwig Schneider, CC BY-SA 3.0</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--kosmos);
    color: rgb(250 246 239 / 0.65);
    padding-block: 2.75rem;
    font-size: 0.88rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .footer-name {
    font-weight: 650;
    color: rgb(250 246 239 / 0.9);
    margin-top: 0;
  }

  .footer-meta {
    line-height: 1.7;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer a {
    color: rgb(250 246 239 / 0.75);
  }

  .footer a:hover {
    color: var(--bursztyn-jasny);
  }

  .footer-credits {
    margin: 2.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(250 246 239 / 0.12);
    font-size: 0.8rem;
    color: rgb(250 246 239 / 0.45);
  }
</style>
