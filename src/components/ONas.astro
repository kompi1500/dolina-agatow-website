---
const priorytety = [
  {
    nr: 'I',
    tytul: 'Przyroda i woda',
    opis: 'Chronimy dolinę Słotwiny, jej bioróżnorodność, retencję i krajobraz przed decyzjami, których skutków nie da się cofnąć.',
  },
  {
    nr: 'II',
    tytul: 'Dziedzictwo geologiczne',
    opis: 'Popularyzujemy wiedzę o lokalnych agatach i Płóczkowskich Polach Agatowych, łącząc geologię z odpowiedzialną geoturystyką.',
  },
  {
    nr: 'III',
    tytul: 'Historia miejsc',
    opis: 'Dokumentujemy zabytki, dawne nazwy, mapy i wspomnienia, zanim znikną z krajobrazu lub lokalnej pamięci.',
  },
  {
    nr: 'IV',
    tytul: 'Wspólnota',
    opis: 'Tworzymy przestrzeń do rozmowy i wspólnego działania mieszkańców Płóczek Górnych, Nagórza i okolic.',
  },
];

const zarzad = [
  { imie: 'Artur Kompanowski', funkcja: 'Prezes Zarządu' },
  { imie: 'Katarzyna Kołodziejczyk', funkcja: 'Wiceprezes' },
  { imie: 'Kinga Nestorowicz', funkcja: 'Sekretarz' },
  { imie: 'Mateusz Markowski', funkcja: 'Członek Zarządu' },
];
---

<section class="about" id="o-nas" aria-labelledby="about-title">
  <div class="container about-heading">
    <span class="section-label">O stowarzyszeniu</span>
    <h2 id="about-title">Mieszkamy tutaj.<br />Dlatego działamy.</h2>
    <div class="about-lead">
      <p>
        Dolina Agatów jest stowarzyszeniem mieszkańców Płóczek Górnych, Nagórza i
        okolic. Chcemy, aby rozwój obu miejscowości wzmacniał lokalną wspólnotę, nie
        niszcząc przy tym krajobrazu i dziedzictwa, które czynią to miejsce wyjątkowym.
      </p>
      <a href="#dolacz">Zobacz, jak dołączyć ↓</a>
    </div>
  </div>

  <div class="container priorities" aria-label="Priorytety stowarzyszenia">
    {priorytety.map((priorytet) => (
      <article>
        <span>{priorytet.nr}</span>
        <h3>{priorytet.tytul}</h3>
        <p>{priorytet.opis}</p>
      </article>
    ))}
  </div>

  <div class="container board">
    <div class="board-title">
      <span class="section-label">Osoby</span>
      <h3>Zarząd stowarzyszenia</h3>
    </div>
    <ol>
      {zarzad.map((osoba, index) => (
        <li>
          <span>0{index + 1}</span>
          <strong>{osoba.imie}</strong>
          <small>{osoba.funkcja}</small>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: var(--heban);
    color: rgb(250 246 239 / 0.84);
  }

  .about-heading {
    display: grid;
    grid-template-columns: minmax(15rem, 0.75fr) minmax(18rem, 0.55fr);
    gap: clamp(2.5rem, 10vw, 10rem);
  }

  .about-heading > .section-label {
    grid-column: 1 / -1;
    margin-bottom: -1rem;
    color: var(--bursztyn-jasny);
  }

  .about h2 {
    margin: 0;
    color: var(--krem);
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .about-lead {
    align-self: end;
    padding-top: 1rem;
    border-top: 1px solid rgb(250 246 239 / 0.38);
  }

  .about-lead p {
    margin: 0 0 1.5rem;
  }

  .about-lead a {
    color: var(--bursztyn-jasny);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .priorities {
    margin-top: clamp(4rem, 9vw, 8rem);
    border-top: 1px solid rgb(250 246 239 / 0.18);
  }

  .priorities article {
    display: grid;
    grid-template-columns: 4rem minmax(12rem, 0.7fr) 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.5rem;
    border-bottom: 1px solid rgb(250 246 239 / 0.18);
  }

  .priorities article > span {
    color: var(--bursztyn-jasny);
    font-family: var(--font-display);
  }

  .priorities h3 {
    margin: 0;
    color: var(--krem);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }

  .priorities p {
    margin: 0;
    max-width: 42rem;
    color: rgb(250 246 239 / 0.64);
  }

  .board {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(2rem, 8vw, 7rem);
    margin-top: clamp(4rem, 9vw, 8rem);
  }

  .board-title h3 {
    margin: 0;
    color: var(--krem);
    font-size: clamp(1.8rem, 3.2vw, 2.7rem);
  }

  .board ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .board li {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid rgb(250 246 239 / 0.16);
  }

  .board li > span,
  .board small {
    color: rgb(250 246 239 / 0.48);
    font-size: 0.72rem;
  }

  @media (min-width: 840px) {
    .about-lead p,
    .priorities p {
      text-align: justify;
      hyphens: auto;
    }
  }

  @media (max-width: 760px) {
    .about-heading,
    .board {
      grid-template-columns: 1fr;
    }

    .priorities article {
      grid-template-columns: 2.5rem 1fr;
    }

    .priorities p {
      grid-column: 2;
    }

    .board li {
      grid-template-columns: 2rem 1fr;
    }

    .board small {
      grid-column: 2;
    }
  }
</style>
