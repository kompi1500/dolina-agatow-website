---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const kroki = [
  'Porozmawiaj z osobą należącą do stowarzyszenia.',
  'Wypełnij pisemną deklarację z rekomendacją dwóch członków.',
  'Zarząd podejmuje uchwałę o przyjęciu nowej osoby.',
];
---

<section class="join" id="dolacz" aria-labelledby="join-title">
  <div class="container join-grid">
    <div class="join-title">
      <span class="section-label">Dołącz do nas</span>
      <h2 id="join-title">Dolina rośnie dzięki ludziom</h2>
      <p>
        Członkiem może zostać każda pełnoletnia osoba, której bliski jest los Płóczek
        Górnych, Nagórza i okolic.
      </p>
    </div>

    <ol class="join-steps">
      {kroki.map((krok, index) => (
        <li>
          <span>0{index + 1}</span>
          <p>{krok}</p>
        </li>
      ))}
    </ol>

    <div class="join-contact">
      <span class="contact-label">Adres stowarzyszenia</span>
      <address>
        <strong>Dolina Agatów</strong><br />
        Płóczki Górne 4A<br />
        59-600 Lwówek Śląski
      </address>
      <a href={`${base}/regulamin/`}>Przeczytaj regulamin członkostwa ↗</a>
    </div>
  </div>
</section>

<style>
  .join {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: var(--bursztyn);
    color: var(--heban);
  }

  .join-grid {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(20rem, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .join .section-label {
    color: var(--heban);
  }

  .join-title h2 {
    max-width: 10ch;
    margin: 0 0 1.4rem;
    font-size: clamp(3rem, 6vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .join-title > p {
    max-width: 30rem;
    margin: 0;
  }

  .join-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(36 28 18 / 0.45);
  }

  .join-steps li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1.3rem;
    border-bottom: 1px solid rgb(36 28 18 / 0.45);
  }

  .join-steps span {
    font-size: 0.7rem;
    font-weight: 750;
  }

  .join-steps p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.25;
  }

  .join-contact {
    grid-column: 2;
    padding-top: 2rem;
    border-top: 1px solid rgb(36 28 18 / 0.45);
  }

  .contact-label {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .join-contact address {
    margin-bottom: 1.4rem;
    font-style: normal;
    line-height: 1.6;
  }

  .join-contact a {
    color: var(--heban);
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .join-grid {
      grid-template-columns: 1fr;
    }

    .join-contact {
      grid-column: auto;
    }
  }
</style>
