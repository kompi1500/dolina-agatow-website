---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const historie = [
  {
    nr: '01',
    id: 'kamien',
    etykieta: 'Kamień',
    tytul: 'Wulkaniczna pamięć zamknięta w kamieniu',
    tekst: [
      'Około 300 milionów lat temu permskie skały wulkaniczne Pogórza Izerskiego wypełniały się pęcherzami gazu. Później krzemionka odkładała się w nich warstwa po warstwie, tworząc agaty o niepowtarzalnym rysunku.',
      'Okolice Płóczek Górnych są jednym z ważnych sudeckich stanowisk agatów migdałowcowych. Każdy przekrój jest małą mapą procesów, które trwały dłużej niż cała historia człowieka.',
    ],
    plik: 'agat-makro.jpg',
    alt: 'Przekrój czerwono-białego agatu z Płóczek Górnych',
    autor: 'Lech Darski',
    licencja: 'CC BY-SA 4.0',
    licencjaUrl: 'https://creativecommons.org/licenses/by-sa/4.0/',
    zrodlo: 'https://commons.wikimedia.org/wiki/File:Agat_-_P%C5%82%C3%B3czki_G%C3%B3rne,_Poland.jpg',
    zmiany: 'kadr i kompresja',
    zrodloFaktow: 'https://jednaziemia.pgi.gov.pl/zasoby-ziemia/75-skalne/kamienie-ozdobne/2282-piekne-agaty.html',
    zrodloLabel: 'PIG-PIB — Piękne agaty',
  },
  {
    nr: '02',
    id: 'krajobraz',
    etykieta: 'Krajobraz',
    tytul: 'Dolina, którą wyznacza Słotwina',
    tekst: [
      'Płóczki Górne i Nagórze łączy dolina Słotwiny: niewielkiego cieku, który porządkuje tutejszy krajobraz. Wzdłuż niego układają się zabudowania, łąki, ogrody i polne drogi.',
      'To krajobraz codzienny, nie pocztówkowy. Jego wartość powstaje z relacji między wodą, rolnictwem, starymi drzewami i rozproszoną zabudową. Właśnie tę skalę chcemy chronić.',
    ],
    plik: 'slotwina.jpg',
    alt: 'Niewielki próg wodny na rzece Słotwinie pośród zieleni',
    autor: 'Jarosław Łukaszewski',
    licencja: 'CC BY-SA 3.0',
    licencjaUrl: 'https://creativecommons.org/licenses/by-sa/3.0/',
    zrodlo: 'https://commons.wikimedia.org/wiki/File:S%C5%82otwina_w_P%C5%82oczkach_G%C3%B3rnych.JPG',
    zmiany: 'kadr i kompresja',
  },
  {
    nr: '03',
    id: 'pamiec',
    etykieta: 'Pamięć',
    tytul: 'Kamień, drewno i ślady wielu pokoleń',
    tekst: [
      'Kościół św. Bartłomieja ma średniowieczny rodowód i pozostaje jednym z najważniejszych punktów historycznego krajobrazu Płóczek Górnych. Jego kamienna wieża pokazuje, jak lokalny materiał i kolejne przebudowy zapisywały historię miejsca.',
      'W Nagórzu znajduje się także XIX-wieczny pałac wpisany do ewidencji zabytków. Dokumentowanie takich obiektów jest pierwszym krokiem do mądrej opieki nad nimi.',
    ],
    plik: 'kosciol-bartlomieja.jpg',
    alt: 'Kamienna wieża kościoła św. Bartłomieja w Płóczkach Górnych',
    autor: 'Sławomir Milejski',
    licencja: 'CC BY-SA 3.0 PL',
    licencjaUrl: 'https://creativecommons.org/licenses/by-sa/3.0/pl/',
    zrodlo: 'https://commons.wikimedia.org/wiki/File:P%C5%82%C3%B3czki_G%C3%B3rne_ko%C5%9Bci%C3%B3%C5%82_%C5%9Bw_Bart%C5%82omieja_sm.jpg',
    zmiany: 'kadr i kompresja',
    zrodloFaktow: 'https://zabytek.pl/pl/obiekty/ploczki-gorne-kosciol-fil-pw-sw-bartlomieja',
    zrodloLabel: 'Narodowy Instytut Dziedzictwa',
  },
  {
    nr: '04',
    id: 'mapa',
    etykieta: 'Mapa',
    tytul: 'Te same doliny, inne nazwy',
    tekst: [
      'Mapa powiatu lwóweckiego z końca XIX wieku pokazuje gęstą sieć dróg, osad i cieków jeszcze pod dawnymi nazwami. Linie topograficzne pozwalają odczytać teren, który do dziś wyznacza rytm obu wsi.',
      'Zestawianie dawnych map ze współczesnym krajobrazem pomaga odnaleźć zatarte drogi, nazwy i miejsca. To narzędzie pamięci, nie tylko dekoracja.',
    ],
    plik: 'mapa-1896.jpg',
    alt: 'Fragment historycznej mapy powiatu lwóweckiego z 1896 roku',
    autor: 'C. Vogel',
    licencja: 'CC0 1.0',
    licencjaUrl: 'https://creativecommons.org/publicdomain/zero/1.0/',
    zrodlo: 'https://commons.wikimedia.org/wiki/File:Landkreis_L%C3%B6wenberg_C.Vogel_vor_1900.jpg',
    zmiany: 'kadr i kompresja',
  },
];
---

<section class="atlas" id="mikroatlas" aria-labelledby="atlas-title">
  <header class="atlas-intro container">
    <div>
      <span class="section-label">Mikroatlas Doliny</span>
      <h2 id="atlas-title">Cztery warstwy jednego miejsca</h2>
    </div>
    <p>
      Dolina nie mieści się w jednym widoku. Czytamy ją przez kamień, wodę, ślady
      historii i mapy — materiały, które pozwalają zobaczyć więcej niż sam punkt na mapie.
    </p>
  </header>

  <div class="atlas-stories">
    {historie.map((historia, index) => (
      <article class:list={['story', { reverse: index % 2 === 1 }]} id={historia.id}>
        <div class="story-grid container">
          <figure class="story-media">
            <img src={`${base}/images/${historia.plik}`} alt={historia.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            <figcaption>
              <span>{historia.alt}</span>
              <span>
                {historia.autor} · <a href={historia.licencjaUrl} target="_blank" rel="license noopener">{historia.licencja}</a>
                {' · '}
                <a href={historia.zrodlo} target="_blank" rel="noopener">Wikimedia Commons</a>
                {' · '}{historia.zmiany}
              </span>
            </figcaption>
          </figure>

          <div class="story-copy">
            <div class="story-index" aria-hidden="true">
              <span>{historia.nr}</span>
              <i></i>
              <span>{historia.etykieta}</span>
            </div>
            <h3>{historia.tytul}</h3>
            <div class="story-prose">
              {historia.tekst.map((akapit) => <p>{akapit}</p>)}
            </div>
            {historia.zrodloFaktow && (
              <a class="source-link" href={historia.zrodloFaktow} target="_blank" rel="noopener">
                Źródło: {historia.zrodloLabel} ↗
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .atlas {
    background: var(--krem);
  }

  .atlas-intro {
    display: grid;
    grid-template-columns: 1fr minmax(20rem, 0.8fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .atlas-intro h2 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2.7rem, 6vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .atlas-intro > p {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--atrament);
    font-size: 1rem;
  }

  .story {
    padding-block: clamp(4rem, 8vw, 8rem);
    border-top: 1px solid rgb(46 42 34 / 0.18);
  }

  .story:nth-child(even) {
    background: var(--krem-cien);
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(18rem, 0.78fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: center;
  }

  .story.reverse .story-media {
    grid-column: 2;
  }

  .story.reverse .story-copy {
    grid-column: 1;
    grid-row: 1;
  }

  .story-media {
    margin: 0;
  }

  .story-media img {
    width: 100%;
    max-height: 44rem;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.03);
  }

  .story:nth-child(3) .story-media img,
  .story:nth-child(4) .story-media img {
    aspect-ratio: 4 / 5;
  }

  .story-media figcaption {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    margin-top: 0.65rem;
    font-size: 0.64rem;
    line-height: 1.4;
    color: var(--atrament-mute);
  }

  .story-media figcaption span:last-child {
    text-align: right;
  }

  .story-index {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 2rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rdza);
  }

  .story-index i {
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  .story-copy h3 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.15rem, 4.2vw, 3.8rem);
    line-height: 1.03;
    letter-spacing: -0.025em;
  }

  .story-prose {
    font-size: 1rem;
  }

  .story-prose p {
    margin: 0 0 1em;
  }

  .source-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.72rem;
    font-weight: 650;
    color: var(--turkus-ciemny);
  }

  @media (min-width: 840px) {
    .story-prose {
      text-align: justify;
      text-justify: inter-word;
      hyphens: auto;
    }
  }

  @media (max-width: 839px) {
    .atlas-intro,
    .story-grid {
      grid-template-columns: 1fr;
    }

    .atlas-intro {
      align-items: start;
      gap: 2rem;
    }

    .story.reverse .story-media,
    .story.reverse .story-copy {
      grid-column: auto;
      grid-row: auto;
    }

    .story-copy {
      order: -1;
    }

    .story-media figcaption {
      grid-template-columns: 1fr;
    }

    .story-media figcaption span:last-child {
      text-align: left;
    }
  }

  @media (max-width: 520px) {
    .story-media {
      margin-inline: calc(-1 * var(--pad-x));
    }

    .story-media figcaption {
      padding-inline: var(--pad-x);
    }

    .story-media img,
    .story:nth-child(3) .story-media img,
    .story:nth-child(4) .story-media img {
      aspect-ratio: 4 / 5;
    }
  }
</style>
