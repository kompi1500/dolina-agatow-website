---
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${frontmatter.title} — Dolina Agatów`}>
  <header class="doc-header">
    <div class="container">
      <a href={`${base}/`} class="back">← Dolina Agatów</a>
    </div>
  </header>
  <main class="container doc">
    <slot />
    <p class="doc-note">
      Stowarzyszenie wpisane do ewidencji stowarzyszeń zwykłych prowadzonej przez Starostę
      Lwóweckiego pod pozycją 18 (wpis z dnia 6 lipca 2026 r.).
    </p>
  </main>
  <Footer />
</Layout>

<style>
  .doc-header {
    background: var(--heban);
    padding-block: 1.1rem;
  }

  .back {
    color: var(--krem);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .back:hover {
    color: var(--bursztyn-jasny);
  }

  .doc {
    max-width: 46rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .doc :global(h1) {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
  }

  .doc :global(h2) {
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    margin-top: 2.5em;
    padding-top: 1.25em;
    border-top: 1px solid var(--krem-cien);
  }

  .doc :global(h3) {
    color: var(--rdza);
    margin-top: 1.8em;
  }

  .doc :global(ol) {
    padding-left: 1.4rem;
  }

  .doc :global(li) {
    margin-block: 0.4em;
  }

  .doc-note {
    margin-top: 3.5rem;
    padding: 1rem 1.25rem;
    background: var(--krem-cien);
    border-left: 3px solid var(--bursztyn);
    font-size: 0.9rem;
    color: var(--atrament-mute);
  }
</style>
