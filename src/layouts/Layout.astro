---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dolina Agatów — Stowarzyszenie na Rzecz Rozwoju Płóczek Górnych, Nagórza i Okolic',
  description = 'Stowarzyszenie „Dolina Agatów” działa na rzecz zrównoważonego rozwoju oraz ochrony przyrodniczego, geologicznego i kulturowego dziedzictwa Płóczek Górnych, Nagórza i okolic (Pogórze Izerskie, gmina Lwówek Śląski).',
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080706" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta
      property="og:image"
      content={new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/agat-makro.jpg`, Astro.site)}
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`}
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {
      Astro.url.pathname === `${import.meta.env.BASE_URL}` && (
        <>
          <link
            rel="preload"
            as="image"
            href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/media/hero-poster-mobile.jpg`}
            media="(max-width: 640px)"
          />
          <link
            rel="preload"
            as="image"
            href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/media/hero-poster-desktop.jpg`}
            media="(min-width: 641px)"
          />
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
